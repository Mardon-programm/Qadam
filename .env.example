# Qadam — environment template (copy to .env)
APP_ENV=development
APP_NAME=Qadam
APP_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# Launch market
DEFAULT_CITY=bishkek
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,ky

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qadam
POSTGRES_USER=qadam
POSTGRES_PASSWORD=qadam_dev_password
DATABASE_URL=postgresql+asyncpg://qadam:qadam_dev_password@localhost:5432/qadam

# Redis
REDIS_URL=redis://localhost:6379/0

# OTP / SMS (dev uses console logger)
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_PHONE=5

# Payments — mock until real partner contract
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ops bootstrap (first admin; change in production)
OPS_BOOTSTRAP_PHONE=+996700000001
OPS_BOOTSTRAP_NAME=Qadam Ops
